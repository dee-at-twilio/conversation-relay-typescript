# Server
PORT=8080
# Public hostname only — no scheme, no trailing slash (e.g. from ngrok).
# https://<DOMAIN> is used for Twilio webhooks; wss://<DOMAIN>/ws for the WebSocket.
DOMAIN=your-tunnel.ngrok.app

# LLM (OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The Twilio number receiving inbound calls (also used as SMS From)
TWILIO_PHONE_NUMBER=+15551230000
# Where the handover_to_human tool dials
HUMAN_AGENT_NUMBER=+15559990000

# ConversationRelay defaults
CR_WELCOME_GREETING=Hi! How can I help you today?
CR_VOICE=en-US-Journey-O
CR_LANGUAGE=en-US
CR_TTS_PROVIDER=Google
